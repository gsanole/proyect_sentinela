{
  "name": "art-hub-backend",
  "version": "1.0.0",
  "description": "Backend API for Art Hub marketplace",
  "main": "server.js",
  "scripts": {
    "dev": "nodemon server.js",
    "start": "node server.js",
    "migrate": "node migrations/run.js",
    "seed": "node seeds/run.js",
    "test": "jest --coverage",
    "test:unit": "jest __tests__/unit --coverage",
    "test:integration": "jest __tests__/integration --coverage",
    "test:e2e": "jest __tests__/e2e --coverage",
    "test:security": "jest __tests__/security --coverage",
    "test:performance": "jest __tests__/performance --coverage",
    "test:smoke": "jest __tests__/smoke --coverage",
    "test:watch": "jest --watch",
    "test:ci": "jest --ci --coverage --maxWorkers=2"
  },
  "keywords": [
    "art",
    "marketplace",
    "api"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "aws-sdk": "^2.1505.0",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.5.1",
    "express-validator": "^7.0.1",
    "geoip-lite": "^1.4.10",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.7",
    "pg": "^8.11.3",
    "stripe": "^14.9.0",
    "ua-parser-js": "^2.0.6",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "supertest": "^6.3.3"
  }
}
